# ── FlowDraft environment ──
# Copy to ".env" and fill in your keys:   cp .env.example .env
#
# These override the models/*.txt key files when set. If you already keep your
# keys in models/secretapi.txt and models/roboflow_key.txt, you can leave these
# blank — the compose file mounts ./models read-only into the container.

# Anthropic (Claude) — recognition / labeling / OCR
ANTHROPIC_API_KEY=

# Roboflow — hosted room + door/window detectors for floor plans
ROBOFLOW_API_KEY=

# ── Optional tuning ──
# Swap the fixture detector (e.g. a sanitary-class model to get toilet/sink boxes)
# ROBOFLOW_FIXTURE_MODEL=floor-plans-500-r7jy4/1
# ROBOFLOW_FIXTURE_CONF=0.30

# ── Optional services ──
# Use Postgres for the compliance checker (requires: docker compose --profile postgres up)
# DATABASE_URL=postgresql+psycopg2://dc_user:dc_password@postgres:5432/dc_compliance

# Gemini fallback for compliance text extraction (optional)
# GEMINI_API_KEY=
