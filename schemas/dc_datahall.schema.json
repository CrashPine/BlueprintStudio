{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archdraft-flowdraft/contracts/dc_datahall.schema.json",
  "title": "FlowDraft DC Data Hall",
  "description": "Large data hall floor plan: spaces, equipment nodes, optional edges. Coordinates normalized 0-1.",
  "type": "object",
  "required": ["meta", "spaces", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["diagram_id", "diagram_type", "source_file", "parse_confidence"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "minLength": 1 },
        "diagram_type": { "type": "string", "enum": ["DC_DATAHALL"] },
        "source_file": { "type": "string", "minLength": 1 },
        "image_width": { "type": ["integer", "null"], "minimum": 1 },
        "image_height": { "type": ["integer", "null"], "minimum": 1 },
        "parse_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "parser": { "type": "string", "enum": ["cv-hybrid", "claude", "yolo"] },
        "topology": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "room_count": { "type": "integer", "minimum": 0 },
        "total_floor_area_m2": { "type": "number", "minimum": 0 }
      }
    },
    "spaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/space" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "kind": { "type": "string", "enum": ["dimension", "area", "note", "tag", "scale", "other"] },
        "value_mm": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "space": {
      "type": "object",
      "required": ["id", "name", "category", "bbox_2d", "polygon_2d", "area_m2", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "data_hall", "raised_floor", "hot_aisle", "cold_aisle",
            "electrical_room", "ups_room", "noc", "security", "unknown"
          ]
        },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "polygon_2d": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "area_m2": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "tag", "bbox_2d", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": ["rack", "ups", "switchgear", "pdu", "mdp", "crac", "unknown"]
        },
        "tag": { "type": "string" },
        "space_id": { "type": ["string", "null"] },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tonnage_RT": { "type": "number", "minimum": 0 },
            "rack_count": { "type": "integer", "minimum": 0 },
            "rated_power_kW": { "type": "number", "minimum": 0 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "chw_supply", "chw_return", "condenser_water", "air_duct",
            "electrical_cable", "control_signal", "unknown"
          ]
        },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
