{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archdraft-flowdraft/contracts/graph.schema.v2.json",
  "title": "ArchDraft x FlowDraft Unified Graph",
  "description": "Canonical property graph for architectural floor plans AND MEP P&ID/SLD. M1 (vision) writes it; M2 (3D), M3 (PUE/BEC), M4 (what-if), M5 (finance) read it. CONVENTION: all 2D coordinates normalized 0-1 relative to source image.",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["diagram_id", "diagram_type", "source_file", "parse_confidence"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "minLength": 1 },
        "diagram_type": {
          "type": "string",
          "enum": ["FLOORPLAN", "PID", "SLD", "FUSED"],
          "description": "FLOORPLAN=arch only; PID/SLD=MEP; FUSED=rooms+equipment"
        },
        "building_id": {
          "type": ["string", "null"],
          "description": "CSDI BuildingCSUID when anchored (M6)"
        },
        "source_file": { "type": "string", "minLength": 1 },
        "image_width": { "type": ["integer", "null"], "minimum": 1 },
        "image_height": { "type": ["integer", "null"], "minimum": 1 },
        "parse_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "topology": { "type": "string" },
        "parser": {
          "type": "string",
          "enum": ["claude", "yolo", "floorplan-cv", "roboflow+claude", "yolo+claude"],
          "description": "Which parser produced this graph"
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "pue": {
          "type": "number",
          "minimum": 1.0,
          "description": "Power Usage Effectiveness = facility_power / IT_power"
        },
        "it_power_kW": { "type": "number", "minimum": 0 },
        "facility_power_kW": { "type": "number", "minimum": 0 },
        "target_pue": { "type": "number", "minimum": 1.0 },
        "room_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of distinct spaces/rooms in this diagram"
        },
        "total_floor_area_m2": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of all space area_m2"
        },
        "scale_m_per_px": {
          "type": "number",
          "minimum": 0,
          "description": "Calibration from a read dimension annotation; 0 or absent = uncalibrated"
        },
        "scale_ratio": {
          "type": "string",
          "description": "Verbatim plotted scale ratio if printed (e.g. '1:100')"
        },
        "scale_source": {
          "type": "string",
          "enum": ["dimension_line", "annotation", "scale_ratio", "nameplate", "assumed", "none"],
          "description": "How scale_m_per_px was obtained"
        },
        "unit_system": {
          "type": "string",
          "enum": ["metric", "imperial", "mixed"],
          "description": "Dominant measurement system detected in the source drawing"
        },
        "total_floor_area_source": {
          "type": "string",
          "enum": ["annotated", "summed_rooms", "derived", "mixed", "none"],
          "description": "How total_floor_area_m2 was obtained"
        },
        "title": { "type": "string", "description": "Drawing title block name" },
        "drawing_number": { "type": "string", "description": "Drawing/sheet number from the title block" },
        "level": { "type": "string", "description": "Floor/level label (e.g. 'Ground Floor', 'L2')" }
      }
    },
    "spaces": {
      "type": "array",
      "description": "Architectural rooms from floor-plan parse",
      "items": { "$ref": "#/$defs/space" }
    },
    "walls": {
      "type": "array",
      "description": "Wall centerlines from floor-plan parse (optional)",
      "items": { "$ref": "#/$defs/wall" }
    },
    "fixtures": {
      "type": "array",
      "description": "Non-room architectural instances (doors, windows, sanitary, stairs, columns) with deterministic geometry for 3D reconstruction",
      "items": { "$ref": "#/$defs/fixture" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "annotations": {
      "type": "array",
      "description": "Handwritten/margin/red-ink OCR notes (verbatim text, no coordinates)",
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "description": "A transcribed handwritten or red-ink annotation from the drawing",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "Verbatim transcription of the handwritten note"
        },
        "kind": {
          "type": "string",
          "enum": ["dimension", "area", "note", "tag", "scale", "other"],
          "description": "Classification of the annotation"
        },
        "value_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Parsed metric length in millimetres when the note is a dimension"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "capacity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["RT", "kW", "L/s", "CMH", "kVA", "A", "kW_IT"] }
      }
    },
    "efficiency": {
      "type": "object",
      "required": ["metric", "value"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "enum": ["COP", "IPLV", "kW/RT", "EER", "PUE"] },
        "value": { "type": "number" }
      }
    },
    "space": {
      "type": "object",
      "required": ["id", "name", "category", "polygon_2d", "area_m2", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "data_hall", "electrical_room", "plant_room", "mechanical_room", "server_room",
            "office", "meeting_room", "reception", "lobby", "corridor", "hallway",
            "stairwell", "elevator", "bedroom", "bathroom", "toilet", "kitchen", "pantry",
            "living_room", "dining_room", "garage", "storage", "closet", "utility",
            "laundry", "balcony", "terrace", "patio", "garden", "retail", "classroom",
            "unknown"
          ]
        },
        "polygon_2d": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "area_m2": { "type": "number", "minimum": 0 },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "[x_center, y_center, width, height] normalized 0-1, derived from polygon_2d"
        },
        "width_m": { "type": "number", "minimum": 0 },
        "height_m": { "type": "number", "minimum": 0 },
        "floor": { "type": "string" },
        "centroid_2d": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "[x, y] normalized centroid, derived from polygon_2d"
        },
        "area_raw": {
          "type": "string",
          "description": "Verbatim printed area annotation incl. units (e.g. '11,20 m2')"
        },
        "dimensions_raw": {
          "type": "string",
          "description": "Verbatim printed dimensions annotation (e.g. '4.50 x 3.20')"
        },
        "area_source": {
          "type": "string",
          "enum": ["annotated", "derived_scale", "derived_pixels", "estimated", "none"],
          "description": "How area_m2 was obtained for this space"
        },
        "room_number": {
          "type": "string",
          "description": "Verbatim room/space number or code if printed"
        },
        "elevation_m": {
          "type": "number",
          "description": "Floor finish level / elevation if annotated"
        },
        "habitable": {
          "type": "boolean",
          "description": "False for garages, dependencies, and non-habitable areas"
        },
        "it_power_kW": {
          "type": "number",
          "minimum": 0,
          "description": "Allocated IT load for PUE denominator in this space"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "polyline_2d", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "polyline_2d": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "thickness_mm": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "description": "A detected architectural element (opening or fixture). Geometry is deterministic (from a CV detector); size derived from scale.",
      "required": ["id", "category", "bbox_2d", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "category": {
          "type": "string",
          "enum": [
            "door", "sliding_door", "double_door", "folding_door", "garage_door",
            "window", "opening",
            "toilet", "sink", "bathtub", "shower", "bidet",
            "stove", "refrigerator", "dishwasher", "washer", "dryer",
            "stairs", "elevator_car", "column", "unknown"
          ]
        },
        "name": { "type": "string", "description": "Optional human-readable label or OCR text near the fixture" },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "[x_center, y_center, width, height] normalized 0-1 (from detector)"
        },
        "polygon_2d": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "width_m": { "type": "number", "minimum": 0, "description": "Real-world width derived from scale_m_per_px" },
        "height_m": { "type": "number", "minimum": 0, "description": "Real-world depth/height derived from scale_m_per_px" },
        "space_id": {
          "type": ["string", "null"],
          "description": "Room this fixture sits in (point-in-polygon)"
        },
        "wall_id": {
          "type": ["string", "null"],
          "description": "Wall this opening (door/window) is hosted by, when known"
        },
        "floor": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["roboflow", "yolo", "claude", "opencv"],
          "description": "Which detector produced this fixture's geometry"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nodeAttributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rated_power_kW": { "type": "number", "minimum": 0 },
        "annual_energy_kwh": { "type": "number", "minimum": 0 },
        "capacity": { "$ref": "#/$defs/capacity" },
        "efficiency": { "$ref": "#/$defs/efficiency" },
        "voltage_V": { "type": "number", "minimum": 0 },
        "ampacity_A": { "type": "number", "minimum": 0 },
        "install_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "manufacturer": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "floor": { "type": "string" },
        "rack_count": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "tag", "attributes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "description": "High-level symbol category. P&ID taxonomy: instrument, equipment, fitting, valve, signal, tower. Domain refinements allowed below.",
          "enum": [
            "instrument", "equipment", "fitting", "valve", "signal", "tower", "unknown",
            "chiller", "pump", "cooling_tower", "ahu", "fcu", "boiler", "fan",
            "transformer", "switchgear", "breaker", "distribution_panel", "meter",
            "sensor",
            "crac", "crah", "ups", "pdu", "busway", "rack"
          ]
        },
        "sub_type": {
          "type": ["string", "null"],
          "description": "Specific symbol type from the label taxonomy, e.g. globe, ball, control, centrifugal (the 'type' in category.type.collection)."
        },
        "tag": { "type": "string" },
        "space_id": {
          "type": ["string", "null"],
          "description": "Room this equipment sits in (fusion layer)"
        },
        "attributes": { "$ref": "#/$defs/nodeAttributes" },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "rotation_deg": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "edgeAttributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "diameter_mm": { "type": "number", "minimum": 0 },
        "medium": { "type": "string" },
        "flow_lps": { "type": "number", "minimum": 0 },
        "ampacity_A": { "type": "number", "minimum": 0 },
        "phase": { "type": "integer", "enum": [1, 3] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "attributes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "chw_supply", "chw_return", "condenser_water", "air_duct",
            "electrical_cable", "control_signal", "unknown"
          ]
        },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "attributes": { "$ref": "#/$defs/edgeAttributes" },
        "polyline_2d": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
