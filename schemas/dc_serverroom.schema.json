{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archdraft-flowdraft/contracts/dc_serverroom.schema.json",
  "title": "FlowDraft DC Server Room",
  "description": "Small server room: floor zones + equipment. Coordinates normalized 0-1.",
  "type": "object",
  "required": ["meta", "zones", "equipment"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["diagram_id", "diagram_type", "source_file", "parse_confidence"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "minLength": 1 },
        "diagram_type": { "type": "string", "enum": ["DC_SERVERROOM"] },
        "source_file": { "type": "string", "minLength": 1 },
        "image_width": { "type": ["integer", "null"], "minimum": 1 },
        "image_height": { "type": ["integer", "null"], "minimum": 1 },
        "parse_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "parser": { "type": "string", "enum": ["cv-hybrid", "claude", "yolo"] },
        "topology": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "room_count": { "type": "integer", "minimum": 0 },
        "total_area_m2": { "type": "number", "minimum": 0 }
      }
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" }
    },
    "equipment": {
      "type": "array",
      "items": { "$ref": "#/$defs/equipment" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "kind": { "type": "string", "enum": ["dimension", "area", "note", "tag", "scale", "other"] },
        "value_mm": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "zone": {
      "type": "object",
      "required": ["id", "name", "category", "bbox_2d", "polygon_2d", "area_m2", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["aisle", "work_zone", "storage_zone", "unknown"]
        },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "polygon_2d": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "area_m2": { "type": "number", "minimum": 0 },
        "area_sqft": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "equipment": {
      "type": "object",
      "required": ["id", "type", "tag", "bbox_2d", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": ["rack", "aircon", "shelving", "cart", "cabinet", "post", "unknown"]
        },
        "tag": { "type": "string" },
        "zone_id": { "type": ["string", "null"] },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rated_power_kW": { "type": "number", "minimum": 0 },
            "ampacity_A": { "type": "number", "minimum": 0 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
